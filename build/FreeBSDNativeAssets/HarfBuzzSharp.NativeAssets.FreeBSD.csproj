<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>HarfBuzzSharp.NativeAssets.FreeBSD</PackageId>
    <Version>8.3.1.3</Version>
    <Authors>Avalonia contributors</Authors>
    <Description>FreeBSD 15 x64 HarfBuzz native runtime asset built without GLib, Graphite, or ICU.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageOutputPath>$(HOME)/dotnet-nupkg</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(HOME)/dotnet-tmp/freebsd-native-assets/harfbuzz/libHarfBuzzSharp.so"
          Pack="true" PackagePath="runtimes/freebsd.15-x64/native/libHarfBuzzSharp.so" Visible="false" />
    <None Include="$(HOME)/dotnet-tmp/freebsd-native-assets/harfbuzz/COPYING.txt"
          Pack="true" PackagePath="COPYING.txt" Visible="false" />
    <None Include="$(HOME)/dotnet-tmp/freebsd-native-assets/harfbuzz/FTL.txt"
          Pack="true" PackagePath="FTL.txt" Visible="false" />
    <None Include="HarfBuzzSharp.NativeAssets.FreeBSD/README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
